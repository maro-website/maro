{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "maro-final-design-system",
    "mode": "light-only",
    "sourceOfTruth": "maro-final.css"
  },
  "color": {
    "canvas": { "$type": "color", "$value": "#f9f9f9" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "surfaceSoft": { "$type": "color", "$value": "#f3f3f3" },
    "surfaceHover": { "$type": "color", "$value": "#ededed" },
    "ink": { "$type": "color", "$value": "#0a0a0a" },
    "secondary": { "$type": "color", "$value": "#5f5f5f" },
    "muted": { "$type": "color", "$value": "#8a8a8a" },
    "brand": { "$type": "color", "$value": "#253fda" },
    "fort": { "$type": "color", "$value": "#da2525" },
    "success": { "$type": "color", "$value": "#15824b" },
    "warning": { "$type": "color", "$value": "#aa6700" },
    "danger": { "$type": "color", "$value": "#d92d2d" }
  },
  "typography": {
    "fontFamily": { "$type": "fontFamily", "$value": ["Manrope", "Segoe UI", "Arial", "sans-serif"] },
    "letterSpacing": { "$type": "dimension", "$value": "-0.03em" }
  },
  "layout": {
    "canvasMax": { "$type": "dimension", "$value": "70rem" },
    "composerMax": { "$type": "dimension", "$value": "55rem" },
    "navGap": { "$type": "dimension", "$value": "1.875rem" },
    "touchTarget": { "$type": "dimension", "$value": "2.75rem" }
  },
  "spacing": {
    "detail": { "$type": "dimension", "$value": "10px" },
    "component": { "$type": "dimension", "$value": "20px" },
    "section": { "$type": "dimension", "$value": "30px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "12px" },
    "field": { "$type": "dimension", "$value": "16px" },
    "surface": { "$type": "dimension", "$value": "20px" },
    "dialog": { "$type": "dimension", "$value": "24px" }
  },
  "elevation": {
    "default": { "$type": "shadow", "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } }
  }
}
