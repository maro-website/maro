# Maro Beta — environment configuration
# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# ---- Anthropic (Claude Opus 5) — Maro Website ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
# Website generation/edit wall-clock budget (ms). Railway max HTTP = 15 min.
ANTHROPIC_TIMEOUT_MS=870000

# ---- Anthropic chat (maro Fjalë assistant) ----
# Optional dedicated key (maroFjale) for separate billing; falls back to ANTHROPIC_API_KEY.
ANTHROPIC_CHAT_API_KEY=
# Model NAME only (NOT a secret). Defaults to claude-opus-5 if unset.
ANTHROPIC_CHAT_MODEL=claude-opus-5
# Optional output cap for assistant replies (thinking is disabled for chat).
ANTHROPIC_CHAT_MAX_TOKENS=2048

# ---- OpenAI (image tools: Maro Logo, Maro Reklama) ----
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- ElevenLabs (audio tool: maro Zo) ----
ELEVENLABS_API_KEY=
# Optional: override default voice ids used for Femëror / Mashkullor
ELEVEN_VOICE_FEMALE=
ELEVEN_VOICE_MALE=

# ---- Supabase ----
# Recraft private image pilot (server only). Add to Railway WEB, never NEXT_PUBLIC.
RECRAFT_API_KEY=

# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional GA4. Empty disables the integration; only maro.al/www.maro.al collect.
# Basic consent mode: no Google script or analytics requests before opt-in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Service role key (SERVER ONLY — never exposed to the browser). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Private ChatGPT MCP (server only except the public resource URL) ----
# Exact RFC 8707 protected-resource identifier. Keep this identical in the
# Supabase access-token hook and ChatGPT connection metadata.
MARO_MCP_RESOURCE_URL=https://maro.al/api/mcp

# Legacy test purchases remain disabled. New purchases use RaiAccept.
LEGACY_PAYMENTS_ENABLED=false

# Registration remains closed until the final launch gate is explicitly approved.
NEXT_PUBLIC_SIGNUP_ENABLED=false

# Dedicated server-only key for the private maroChat pilot.
MARO_CHAT_OPENAI_API_KEY=
